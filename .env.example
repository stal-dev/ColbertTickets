# Gmail account to send from
GMAIL_USER=your.email@gmail.com

# Gmail App Password (NOT your regular password)
# To create: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Set to "true" to send an email on every check, even when no tickets are available
# Useful for testing or getting regular status updates
ALWAYS_EMAIL=false
